{
  "outputDirectory": "public",
  "functions": {
    "api/admin.js": {
      "includeFiles": "private/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "thelongstatic.cqxet.site"
        }
      ],
      "destination": "/the-long-static/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "thelongstatic.vercel.app"
        }
      ],
      "destination": "/the-long-static/index.html"
    },
    {
      "source": "/admin",
      "destination": "/api/admin"
    },
    {
      "source": "/admin.html",
      "destination": "/api/admin"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/hollowsignal",
      "destination": "/the-long-static/",
      "permanent": false
    },
    {
      "source": "/hollowsignal/",
      "destination": "/the-long-static/",
      "permanent": false
    }
  ]
}